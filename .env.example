APP_NAME=LearnerTutors
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Dedicated concurrent workers for synchronous vector retrieval/embeddings.
RETRIEVAL_WORKERS=64

# Generate a long random secret on the backend and copy the same value into Moodle's Application API key setting.
RAG_API_KEY=
MAX_UPLOAD_MB=20

# One-time encryption key for provider credentials synchronized from Moodle.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable and outside source control. Moodle-managed provider keys
# take precedence over the environment fallback values below.
RUNTIME_CONFIG_ENCRYPTION_KEY=

# Provider credentials and connection settings. Generation model identifiers
# are selected in Moodle and synchronized to the backend at runtime.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_COMPLETION_TOKENS=0
OPENAI_TEMPERATURE=0.2

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=180
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=0

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=180

# Embedding selection is independent from text/image generation.
# The model values below are embedding models only.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small

CHROMA_PATH=./storage/chroma
CHROMA_COLLECTION=learnertutors_chunks
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Optional evaluation-only generation model. Set explicitly before running RAGAS.
RAGAS_LLM_MODEL=
