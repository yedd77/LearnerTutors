APP_NAME=LearnerTutors
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Dedicated concurrent workers for synchronous vector retrieval/embeddings.
# Start at 64 for I/O-bound hosted embeddings; tune against CPU/RAM/Chroma load.
RETRIEVAL_WORKERS=64

RAG_API_KEY=(GENERATE A RANDOM SECRET)
MAX_UPLOAD_MB=20

OPENAI_API_KEY=(INSERT OPENAI API KEY)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=120


# Default LLM used for document prompt suggestions and chat requests
# when the frontend does not send provider/model.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-luna

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=120
OPENAI_TEMPERATURE=0.2

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=180

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=180

# Keep embedding provider/model fixed across document indexing and query search.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=

CHROMA_PATH=./storage/chroma
CHROMA_COLLECTION=learnertutors_chunks
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
