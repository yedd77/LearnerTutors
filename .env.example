APP_NAME=LearnerTutors
APP_ENV=development
HOST=127.0.0.1
PORT=8080

RAG_API_KEY=(GENERATE SECRET TOKEN 48 CHARACTERS)
MAX_UPLOAD_MB=20

OPENAI_API_KEY=(INSERT OPENAI API KEY)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=120

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=(INSERT CHAT MODEL NAME)
OLLAMA_EMBED_MODEL=(INSERT EMBEDDING MODEL NAME)
OLLAMA_TIMEOUT_SECONDS=180

CHROMA_PATH=./storage/chroma
CHROMA_COLLECTION=learnertutors_chunks
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

GEMINI_API_KEY=(INSERT GEMINI API KEY)