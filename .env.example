APP_NAME=LearnerTutors
APP_ENV=development
HOST=127.0.0.1
PORT=8080

RAG_API_KEY=(GENERATE SECRET TOKEN 48 CHARACTERS)
MAX_UPLOAD_MB=20

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=(INSERT CHAT MODEL NAME)
OLLAMA_EMBED_MODEL=(INSERT EMBEDDING MODEL NAME)
OLLAMA_TIMEOUT_SECONDS=180

CHROMA_PATH=./storage/chroma
CHROMA_COLLECTION=learnertutors_chunks
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

GEMINI_API_KEY=(INSERT GEMINI API KEY)